# Copy to .env and fill in to enable LLM-backed answer correction via
# OpenRouter. Without this file (or without OPENROUTER_API_KEY set some other
# way), the API falls back to the deterministic diff-based grader — nothing
# breaks, correction just tolerates fewer paraphrases.

OPENROUTER_API_KEY=

# Optional. Defaults to anthropic/claude-3.5-haiku, chosen for cost and
# instruction-following on a narrow grading task. Any model listed at
# https://openrouter.ai/models works.
# OPENROUTER_MODEL=anthropic/claude-3.5-haiku

# Optional. Sent as HTTP-Referer / X-Title so usage shows up correctly in
# your OpenRouter dashboard.
# OPENROUTER_HTTP_REFERER=https://your-deployment.example.com
# OPENROUTER_APP_TITLE=LinguaLab
